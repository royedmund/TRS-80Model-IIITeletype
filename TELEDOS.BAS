10 REM TELETYPE V1.0 - TRSDOS DISK BASIC
20 REM FAST LOCAL LOOPBACK OR EXPERIMENTAL RS232
30 REM OPTIONAL Z80 PAPER FEED - MEMORY SIZE 61439
40 CLEAR 200
45 T=PEEK(16561)+256*PEEK(16562)
50 V=15360:C=0:B=9600:M=1:Q=0:F=0
55 IF T=61439 THEN GOSUB 880
60 CLS
70 A$="TRS-80 MODEL III TELETYPE V0.9"
80 Y=0:GOSUB 500
90 A$="SELECT OPERATING MODE"
100 Y=2:GOSUB 500
110 A$="1 - FAST LOCAL LOOPBACK (DEFAULT)"
120 Y=4:GOSUB 500
130 A$="2 - REAL RS232 SERIAL PORT"
140 Y=5:GOSUB 500
150 A$="PRESS 1, 2 OR ENTER"
160 Y=7:GOSUB 500
170 A$=INKEY$:IF A$="" THEN 170
180 IF A$="2" THEN M=2:GOTO 220
190 IF A$="1" THEN 320
200 IF ASC(A$)=13 THEN 320
210 GOTO 170
220 CLS
230 A$="REAL RS232 BAUD RATE (8N1)"
240 Y=0:GOSUB 500
250 A$="1 - 9600 BAUD (DEFAULT)    2 - 300 BAUD"
260 Y=2:GOSUB 500
270 A$="PRESS 1, 2 OR ENTER"
280 Y=4:GOSUB 500
290 A$=INKEY$:IF A$="" THEN 290
300 IF A$="2" THEN B=300:GOTO 315
305 IF A$<>"1" AND ASC(A$)<>13 THEN 290
315 GOSUB 900
320 CLS
330 A$="TRS-80 MODEL III TELETYPE"
340 Y=0:GOSUB 500
345 IF M=1 THEN A$="LOCAL LOOPBACK - UNTHROTTLED"
350 IF M=2 THEN A$="REAL RS232 - REMOTE ECHO EXPECTED"
355 Y=1:GOSUB 500
360 IF M=2 AND B=9600 THEN A$="9600 BAUD 8N1"
365 IF M=2 AND B=300 THEN A$="300 BAUD 8N1"
370 IF M=2 THEN Y=2:GOSUB 500
375 A$="ENTER=FEED (LOCAL)  CTRL-]=EXIT"
380 Y=15:GOSUB 500
385 POKE V+832,94
386 IF F=1 THEN A$="Z80 FAST PAPER FEED" ELSE A$="BASIC PAPER FEED - SLOW"
387 Y=14:GOSUB 500
390 IF M=2 THEN GOTO 1000
395 REM LOCAL KEYBOARD LOOP - NO SERIAL TIMING
400 A$=INKEY$:IF A$="" THEN 400
405 K=ASC(A$)
410 IF K=29 THEN CLS:END
415 IF K=13 OR K=10 THEN GOTO 700
420 IF K=8 THEN GOSUB 800:GOTO 400
425 IF K<32 OR K>126 THEN 400
430 POKE V+768+C,K
435 POKE V+832+C,32
440 C=C+1
445 IF C=64 THEN GOTO 700
450 POKE V+832+C,94
455 GOTO 400
500 REM WRITE MENU STRING TO VIDEO
510 FOR J=1 TO LEN(A$)
520 POKE V+Y*64+J-1,ASC(MID$(A$,J,1))
530 NEXT J
540 RETURN
700 REM PAPER FEED: MACHINE CODE OR BASIC FALLBACK
710 IF F=1 THEN Z=USR0(0):GOTO 740
720 FOR R=3 TO 11:FOR J=0 TO 63:POKE V+R*64+J,PEEK(V+(R+1)*64+J):NEXT J:NEXT R
730 FOR J=0 TO 63:POKE V+768+J,32:NEXT J
740 IF C<64 THEN POKE V+832+C,32
750 C=0:POKE V+832,94
755 IF M=1 THEN GOTO 400
760 RETURN
800 REM BACKSPACE ONE CHARACTER
810 IF C=0 THEN RETURN
815 POKE V+832+C,32
820 C=C-1:POKE V+768+C,32
830 POKE V+832+C,94
840 RETURN
880 REM INSTALL Z80 LDIR ROUTINE AT F000 HEX
881 FOR I=0 TO 32:READ D:POKE -4096+I,D:NEXT I
885 DEFUSR0=-4096:F=1:RETURN
900 REM CONFIGURE REAL MODEL III RS232 ONLY
910 OUT 232,0
920 IF B=9600 THEN OUT 233,238
930 IF B=300 THEN OUT 233,85
940 OUT 234,104
950 RETURN
1000 REM EXPERIMENTAL REAL RS232 POLL LOOP
1010 S=INP(234)
1020 IF (S AND 128)<>0 THEN RX=INP(235):GOSUB 1200
1030 A$=INKEY$:IF A$="" THEN 1000
1040 TX=ASC(A$)
1050 IF TX=29 THEN CLS:END
1060 S=INP(234)
1070 IF (S AND 64)=0 THEN 1060
1080 OUT 235,TX
1090 GOTO 1000
1200 REM PRINT RECEIVED SERIAL CHARACTER
1210 IF RX=13 THEN Q=1:GOSUB 700:RETURN
1220 IF RX=10 AND Q=1 THEN Q=0:RETURN
1230 Q=0
1240 IF RX=10 THEN GOSUB 700:RETURN
1250 IF RX=8 THEN GOSUB 800:RETURN
1260 IF RX<32 OR RX>126 THEN RETURN
1270 POKE V+768+C,RX
1280 POKE V+832+C,32
1290 C=C+1
1300 IF C=64 THEN GOSUB 700:RETURN
1310 POKE V+832+C,94
1320 RETURN
1400 REM Z80: PRESERVE AF BC DE HL; SCROLL; RESTORE
1410 DATA 245,197,213,229,33,0,61,17,192,60,1,64,2,237,176
1420 DATA 33,0,63,54,32,17,1,63,1,63,0,237,176
1430 DATA 225,209,193,241,201
