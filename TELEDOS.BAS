10 REM TELETYPE V1.1 - TRSDOS DISK BASIC
20 REM SCREEN TEST: UNTHROTTLED LOCAL LOOPBACK
30 REM OPTION: REAL RS232 9600 OR 300 BAUD 8N1
35 REM FOR FAST FEED USE MEMORY SIZE 61439
40 CLEAR 200
45 T=PEEK(16561)+256*PEEK(16562)
50 V=15360:C=0:B=9600:M=1:Q=0:F=0
55 IF T=61439 THEN GOSUB 880
60 CLS
70 A$="TRS-80 MODEL III TELETYPE V1.1"
80 Y=0:GOSUB 600
90 A$="SELECT MODE"
100 Y=2:GOSUB 600
110 A$="1 - LOCAL SCREEN TEST (DEFAULT)"
120 Y=4:GOSUB 600
130 A$="2 - REAL RS232"
140 Y=5:GOSUB 600
150 A$="1, 2 OR ENTER"
160 Y=7:GOSUB 600
170 A$=INKEY$:IF A$="" THEN 170
180 IF A$="2" THEN M=2:GOTO 220
190 IF A$="1" THEN 320
200 IF ASC(A$)=13 THEN 320
210 GOTO 170
220 CLS
230 A$="REAL RS232 - 8N1 BAUD RATE"
240 Y=0:GOSUB 600
250 A$="1 - 9600 (DEFAULT)   2 - 300"
260 Y=2:GOSUB 600
270 A$="1, 2 OR ENTER"
280 Y=4:GOSUB 600
290 A$=INKEY$:IF A$="" THEN 290
300 IF A$="2" THEN B=300:GOTO 315
305 IF A$<>"1" AND ASC(A$)<>13 THEN 290
315 GOSUB 900
320 CLS
325 REM NO HEADER - PAPER USES ALL ROWS 0-14
330 REM PRINTHEAD MOVES ON BOTTOM ROW 15
340 POKE V+960,94
350 IF M=2 THEN GOTO 1000
400 REM LOCAL MODE - NO BAUD RATE OR SOUND
410 A$=INKEY$:IF A$="" THEN 410
420 K=ASC(A$)
430 IF K=29 THEN CLS:END
440 IF K=13 OR K=10 THEN GOSUB 700:GOTO 410
450 IF K=8 THEN GOSUB 800:GOTO 410
460 IF K<32 OR K>126 THEN 410
470 POKE V+896+C,K
480 POKE V+960+C,32
490 C=C+1
500 REM SCREEN MENU TEXT VIA DIRECT VIDEO RAM
510 IF C<64 THEN POKE V+960+C,94:GOTO 410
520 GOSUB 700:GOTO 410
530 REM MENU RENDER ROUTINE AT 600
600 FOR J=1 TO LEN(A$)
610 POKE V+Y*64+J-1,ASC(MID$(A$,J,1))
620 NEXT J
630 RETURN
700 REM PAPER FEED - SHIFT ROWS 1-14 TO 0-13
710 IF F=1 THEN Z=USR0(0):GOTO 740
720 FOR R=0 TO 13:FOR J=0 TO 63:POKE V+R*64+J,PEEK(V+(R+1)*64+J):NEXT J:NEXT R
730 FOR J=0 TO 63:POKE V+896+J,32:NEXT J
740 IF C<64 THEN POKE V+960+C,32
750 C=0:POKE V+960,94
760 RETURN
800 REM BACKSPACE
810 IF C=0 THEN RETURN
815 POKE V+960+C,32
820 C=C-1:POKE V+896+C,32
830 POKE V+960+C,94
840 RETURN
880 REM INSTALL 33 BYTE Z80 VIDEO SCROLLER AT F000H
881 FOR I=0 TO 32:READ D:POKE -4096+I,D:NEXT I
885 DEFUSR0=-4096:F=1:RETURN
900 REM REAL MODEL III RS232
910 OUT 232,0
920 IF B=9600 THEN OUT 233,238
930 IF B=300 THEN OUT 233,85
940 OUT 234,104
950 RETURN
1000 REM REAL RS232 MODE - REMOTE ECHO REQUIRED
1010 S=INP(234)
1020 IF (S AND 128)<>0 THEN RX=INP(235):GOSUB 1200
1030 A$=INKEY$:IF A$="" THEN 1000
1040 TX=ASC(A$)
1050 IF TX=29 THEN CLS:END
1060 S=INP(234)
1070 IF (S AND 64)=0 THEN 1060
1080 OUT 235,TX
1090 GOTO 1000
1200 REM RECEIVED CHARACTER
1210 IF RX=13 THEN Q=1:GOSUB 700:RETURN
1220 IF RX=10 AND Q=1 THEN Q=0:RETURN
1230 Q=0
1240 IF RX=10 THEN GOSUB 700:RETURN
1250 IF RX=8 THEN GOSUB 800:RETURN
1260 IF RX<32 OR RX>126 THEN RETURN
1270 POKE V+896+C,RX
1280 POKE V+960+C,32
1290 C=C+1
1300 IF C=64 THEN GOSUB 700:RETURN
1310 POKE V+960+C,94
1320 RETURN
1400 REM Z80: PRESERVE REGS; LDIR UP; CLEAR ROW 14
1410 DATA 245,197,213,229,33,64,60,17,0,60,1,128,3,237,176
1420 DATA 33,128,63,54,32,17,129,63,1,63,0,237,176
1430 DATA 225,209,193,241,201
