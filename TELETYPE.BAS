10 REM TELETYPE PAPER AND PRINTHEAD - MODEL III LDOS
20 REM VISUAL PROTOTYPE - NO RS232 OR SOUND YET
30 DEFINT A-Z
40 DIM P$(10)
50 W=58:C=0:K=0
60 FOR I=0 TO 10:P$(I)="":NEXT I
70 CLS
80 PRINT@0,"TRS-80 MODEL III  *  TELETYPE PAPER SIMULATOR";
90 PRINT@64,STRING$(62,CHR$(191));
100 GOSUB 500
110 GOSUB 650
120 A$=INKEY$:IF A$="" THEN 120
130 A=ASC(A$)
140 IF A=29 THEN CLS:END
150 IF A=13 THEN GOSUB 800:GOTO 120
160 IF A=10 THEN GOSUB 800:GOTO 120
170 IF A=8 THEN GOSUB 900:GOTO 120
180 IF A<32 OR A>126 THEN 120
190 GOSUB 300
200 GOTO 120
300 REM PRINT ONE CHARACTER AND MOVE PRINTHEAD
310 IF C>=W THEN GOSUB 800
320 P$(10)=P$(10)+A$
330 PRINT@769+C,A$;
340 C=C+1
350 GOSUB 650
360 RETURN
500 REM PAINT PAPER (ROWS 2 THROUGH 12)
510 FOR R=0 TO 10
520 PRINT@128+R*64,"|";LEFT$(P$(R)+SPACE$(W),W);"|";
530 NEXT R
540 RETURN
650 REM MOVE PRINTHEAD ALONG ITS TRACK
660 PRINT@832,SPACE$(62);
670 PRINT@833+C,"^";
680 PRINT@896,"300 BAUD  8N1  |  ENTER=LINE FEED  BACKSPACE=ERASE";
690 PRINT@960,"TYPE TO PRINT  |  CTRL-] TO EXIT";
700 RETURN
800 REM FEED PAPER UP ONE LINE
810 FOR R=0 TO 9:P$(R)=P$(R+1):NEXT R
820 P$(10)="":C=0
830 GOSUB 500
840 GOSUB 650
850 RETURN
900 REM BACKSPACE ONE PRINT POSITION
910 IF C=0 THEN RETURN
920 C=C-1
930 P$(10)=LEFT$(P$(10),C)
940 PRINT@769+C," ";
950 GOSUB 650
960 RETURN
