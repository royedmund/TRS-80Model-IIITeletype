10 REM TELETYPE - LOCAL RS232 LOOPBACK SIMULATION
20 REM LDOS MODEL III - NO PHYSICAL SERIAL I/O
30 DEFINT A-Z
40 DIM P$(10)
50 W=58:C=0:TX=0:RX=0
60 FOR I=0 TO 10:P$(I)="":NEXT I
70 CLS
80 PRINT@0,"TRS-80 MODEL III * TELETYPE LOCAL LOOPBACK";
90 PRINT@64,STRING$(62,"-");
100 GOSUB 500
110 GOSUB 650
120 A$=INKEY$:IF A$="" THEN 120
130 TX=ASC(A$)
140 IF TX=29 THEN CLS:END
150 GOSUB 210
160 GOTO 120
210 REM VIRTUAL RS232: SEND BYTE AND RECEIVE SAME BYTE
220 RX=TX
230 IF RX=13 OR RX=10 THEN GOSUB 800:RETURN
240 IF RX=8 THEN GOSUB 900:RETURN
250 IF RX<32 OR RX>126 THEN RETURN
260 A$=CHR$(RX):GOSUB 300
270 RETURN
300 REM PRINT RECEIVED CHARACTER AND ADVANCE HEAD
310 IF C>=W THEN GOSUB 800
320 P$(10)=P$(10)+A$
330 PRINT@769+C,A$;
340 C=C+1
350 GOSUB 650
360 RETURN
500 REM PAINT PAPER ROWS 2 THROUGH 12
510 FOR R=0 TO 10
520 PRINT@128+R*64,"|";LEFT$(P$(R)+SPACE$(W),W);"|";
530 NEXT R
540 RETURN
650 REM PRINTHEAD POSITION BELOW ACTIVE PAPER ROW
660 PRINT@832,SPACE$(62);
670 PRINT@833+C,"^";
680 PRINT@896,"LOCAL LOOPBACK (SIMULATED)  |  ENTER=LINE FEED";
690 PRINT@960,"300 8N1 TARGET  |  CTRL-] TO EXIT";
700 RETURN
800 REM FEED PAPER UP; RESET PRINTHEAD TO LEFT
810 FOR R=0 TO 9:P$(R)=P$(R+1):NEXT R
820 P$(10)="":C=0
830 GOSUB 500
840 GOSUB 650
850 RETURN
900 REM BACKSPACE ONE PRINT POSITION
910 IF C=0 THEN RETURN
920 C=C-1
930 P$(10)=LEFT$(P$(10),C)
940 PRINT@769+C," ";
950 GOSUB 650
960 RETURN
