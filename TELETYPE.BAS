10 REM TELETYPE V0.7 - TRSDOS MODEL III DISK BASIC
20 REM FAST LOCAL LOOPBACK OR EXPERIMENTAL REAL RS232
30 REM FUTURE: HALF AND FULL DUPLEX SERIAL OPTIONS
40 CLEAR 200
50 V=15360:C=0:B=9600:M=1:Q=0
60 CLS
70 A$="TRS-80 MODEL III TELETYPE V0.7"
80 Y=0:GOSUB 500
90 A$="SELECT OPERATING MODE"
100 Y=2:GOSUB 500
110 A$="1 - LOCAL LOOPBACK (FAST, DEFAULT)"
120 Y=4:GOSUB 500
130 A$="2 - REAL RS232 SERIAL PORT"
140 Y=5:GOSUB 500
150 A$="PRESS 1, 2 OR ENTER"
160 Y=7:GOSUB 500
170 A$=INKEY$:IF A$="" THEN 170
180 IF A$="2" THEN M=2:GOTO 220
190 IF A$="1" THEN 320
200 IF ASC(A$)=13 THEN 320
210 GOTO 170
220 CLS
230 A$="REAL RS232 BAUD RATE (8N1)"
240 Y=0:GOSUB 500
250 A$="1 - 9600 BAUD (DEFAULT)    2 - 300 BAUD"
260 Y=2:GOSUB 500
270 A$="PRESS 1, 2 OR ENTER"
280 Y=4:GOSUB 500
290 A$=INKEY$:IF A$="" THEN 290
300 IF A$="2" THEN B=300:GOTO 315
305 IF A$<>"1" AND ASC(A$)<>13 THEN 290
315 GOSUB 900
320 CLS
330 A$="TRS-80 MODEL III TELETYPE"
340 Y=0:GOSUB 500
345 IF M=1 THEN A$="LOCAL SOFTWARE LOOPBACK - NO BAUD LIMIT"
350 IF M=2 THEN A$="REAL RS232 - REMOTE ECHO EXPECTED"
355 Y=1:GOSUB 500
360 IF M=2 AND B=9600 THEN A$="9600 BAUD 8N1"
365 IF M=2 AND B=300 THEN A$="300 BAUD 8N1"
370 IF M=2 THEN Y=2:GOSUB 500
375 A$="ENTER=FEED (LOCAL)  CTRL-]=EXIT"
380 Y=15:GOSUB 500
385 POKE V+832,94
390 IF M=2 THEN GOTO 1000
395 REM FAST LOCAL KEYBOARD LOOP - NO BAUD DELAY
400 A$=INKEY$:IF A$="" THEN 400
405 K=ASC(A$)
410 IF K=29 THEN CLS:END
415 IF K=13 OR K=10 THEN GOSUB 700:GOTO 400
420 IF K=8 THEN GOSUB 800:GOTO 400
425 IF K<32 OR K>126 THEN 400
430 POKE V+768+C,K
435 POKE V+832+C,32
440 C=C+1
445 IF C=64 THEN GOSUB 700:GOTO 400
450 POKE V+832+C,94
455 GOTO 400
500 REM PRINT A$ AT TOP OF SCREEN ROW Y
510 FOR J=1 TO LEN(A$)
520 POKE V+Y*64+J-1,ASC(MID$(A$,J,1))
530 NEXT J
540 RETURN
700 REM PAPER FEED - COPY PRINTED ROWS UP
710 FOR R=3 TO 11
720 FOR J=0 TO 63
730 POKE V+R*64+J,PEEK(V+(R+1)*64+J)
740 NEXT J
750 NEXT R
760 FOR J=0 TO 63:POKE V+768+J,32:NEXT J
765 IF C<64 THEN POKE V+832+C,32
770 C=0:POKE V+832,94
780 RETURN
800 REM BACKSPACE WITHOUT REDRAWING PRINTHEAD ROW
810 IF C=0 THEN RETURN
815 POKE V+832+C,32
820 C=C-1:POKE V+768+C,32
830 POKE V+832+C,94
840 RETURN
900 REM MODEL III RS232 CONTROL - REAL MODE ONLY
910 OUT 232,0
920 IF B=9600 THEN OUT 233,238
930 IF B=300 THEN OUT 233,85
940 OUT 234,104
950 RETURN
1000 REM REAL RS232 POLL LOOP
1010 S=INP(234)
1020 IF (S AND 128)<>0 THEN RX=INP(235):GOSUB 1200
1030 A$=INKEY$:IF A$="" THEN 1000
1040 TX=ASC(A$)
1050 IF TX=29 THEN CLS:END
1060 S=INP(234)
1070 IF (S AND 64)=0 THEN 1060
1080 OUT 235,TX
1090 GOTO 1000
1200 REM PRINT RECEIVED SERIAL CHARACTER
1210 IF RX=13 THEN Q=1:GOSUB 700:RETURN
1220 IF RX=10 AND Q=1 THEN Q=0:RETURN
1230 Q=0
1240 IF RX=10 THEN GOSUB 700:RETURN
1250 IF RX=8 THEN GOSUB 800:RETURN
1260 IF RX<32 OR RX>126 THEN RETURN
1270 POKE V+768+C,RX
1280 POKE V+832+C,32
1290 C=C+1
1300 IF C=64 THEN GOSUB 700:RETURN
1310 POKE V+832+C,94
1320 RETURN
