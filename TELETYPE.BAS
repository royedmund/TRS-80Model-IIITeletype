10 REM TELETYPE - LOCAL LOOPBACK - MODEL III LDOS
20 REM NO REAL RS232 OR CASSETTE SOUND IN THIS VERSION
30 DEFINT A-Z
35 CLEAR 2000
40 DIM P$(10)
50 W=58:C=0:TX=0:RX=0
60 FOR I=0 TO 10:P$(I)="":NEXT I
70 CLS
80 PRINT@0,"TRS-80 MODEL III * TELETYPE LOCAL LOOPBACK";
90 PRINT@64,"--------------------------------------------------------------";
100 GOSUB 500
110 GOSUB 650
120 A$=INKEY$:IF A$="" THEN 120
130 TX=ASC(A$)
140 IF TX=29 THEN CLS:END
150 GOSUB 210
160 GOTO 120
210 REM VIRTUAL RS232: TX TO RX, SOFTWARE ECHO ONLY
220 RX=TX
230 IF RX=13 OR RX=10 THEN GOSUB 800:RETURN
240 IF RX=8 THEN GOSUB 900:RETURN
250 IF RX<32 OR RX>126 THEN RETURN
260 A$=CHR$(RX):GOSUB 300
270 RETURN
300 REM PRINT ONE RECEIVED CHARACTER; ADVANCE HEAD
310 IF C>=W THEN GOSUB 800
320 P$(10)=P$(10)+A$
330 PRINT@769+C,A$;
340 C=C+1
350 GOSUB 650
360 RETURN
500 REM REDRAW PAPER WINDOW WITHOUT STRING$ OR SPACE$
510 FOR R=0 TO 10
520 PRINT@128+R*64,"|                                                          |";
530 PRINT@129+R*64,P$(R);
540 NEXT R
550 RETURN
650 REM SHOW PRINTHEAD AT CURRENT COLUMN
660 PRINT@832,"                                                              ";
670 PRINT@833+C,"^";
680 PRINT@896,"LOCAL LOOPBACK SIMULATION  |  ENTER=LINE FEED";
690 PRINT@960,"300 8N1 TARGET  |  CTRL-] TO EXIT";
700 RETURN
800 REM FEED PAPER UP; MOVE PRINTHEAD TO LEFT MARGIN
810 FOR R=0 TO 9:P$(R)=P$(R+1):NEXT R
820 P$(10)="":C=0
830 GOSUB 500
840 GOSUB 650
850 RETURN
900 REM BACKSPACE ONE PRINT POSITION
910 IF C=0 THEN RETURN
920 C=C-1
930 P$(10)=LEFT$(P$(10),C)
940 PRINT@769+C," ";
950 GOSUB 650
960 RETURN
