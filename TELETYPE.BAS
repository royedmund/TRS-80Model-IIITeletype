10 REM TELETYPE V0.3 - TRS-80 MODEL III DISK BASIC
20 REM LOCAL SOFTWARE LOOPBACK - NO REAL RS232
30 REM PAPER ROLLS UP ON LINE FEED
40 CLEAR 200
50 V=15360:W=58:C=0
60 CLS
70 A$="TRS-80 MODEL III TELETYPE - LOCAL MODE"
80 Y=0:GOSUB 500
90 A$="SIMULATED TX TO RX - 300 8N1 TARGET"
100 Y=1:GOSUB 500
110 A$="ENTER=FEED  BACKSPACE=ERASE  CTRL-]=EXIT"
120 Y=15:GOSUB 500
130 FOR R=3 TO 12
140 POKE V+R*64+1,124
150 POKE V+R*64+60,124
160 NEXT R
170 GOSUB 600
180 A$=INKEY$:IF A$="" THEN 180
190 TX=ASC(A$)
200 IF TX=29 THEN CLS:END
210 RX=TX:REM SOFTWARE LOOPBACK
220 IF RX=13 OR RX=10 THEN GOSUB 700:GOTO 180
230 IF RX=8 THEN GOSUB 800:GOTO 180
240 IF RX<32 OR RX>126 THEN 180
250 IF C>=W THEN GOSUB 700
260 POKE V+12*64+2+C,RX
270 C=C+1:GOSUB 600
280 GOTO 180
500 REM WRITE A$ AT START OF SCREEN ROW Y
510 FOR J=1 TO LEN(A$)
520 POKE V+Y*64+J-1,ASC(MID$(A$,J,1))
530 NEXT J
540 RETURN
600 REM MOVE PRINTHEAD MARKER BELOW PAPER
610 FOR J=2 TO 59:POKE V+13*64+J,32:NEXT J
620 POKE V+13*64+2+C,94
630 RETURN
700 REM PAPER FEED: SHIFT 10 PAPER ROWS UP
710 FOR R=3 TO 11
720 FOR J=2 TO 59
730 POKE V+R*64+J,PEEK(V+(R+1)*64+J)
740 NEXT J
750 NEXT R
760 FOR J=2 TO 59:POKE V+12*64+J,32:NEXT J
770 C=0:GOSUB 600
780 RETURN
800 REM BACKSPACE ONE POSITION
810 IF C=0 THEN RETURN
820 C=C-1:POKE V+12*64+2+C,32
830 GOSUB 600
840 RETURN
