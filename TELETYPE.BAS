10 REM TELETYPE V0.4 - TRS-80 MODEL III DISK BASIC
20 REM LOCAL SOFTWARE LOOPBACK - NO REAL RS232
30 REM FULL 64 COLUMN PAPER - NO SIDE BORDERS
40 CLEAR 200
50 V=15360:W=64:C=0
60 CLS
70 A$="TRS-80 MODEL III TELETYPE - LOCAL MODE"
80 Y=0:GOSUB 500
90 A$="SIMULATED TX TO RX - 300 8N1 TARGET"
100 Y=1:GOSUB 500
110 A$="ENTER=FEED  BACKSPACE=ERASE  CTRL-]=EXIT"
120 Y=15:GOSUB 500
130 GOSUB 600
140 A$=INKEY$:IF A$="" THEN 140
150 TX=ASC(A$)
160 IF TX=29 THEN CLS:END
170 RX=TX:REM SOFTWARE LOOPBACK
180 IF RX=13 OR RX=10 THEN GOSUB 700:GOTO 140
190 IF RX=8 THEN GOSUB 800:GOTO 140
200 IF RX<32 OR RX>126 THEN 140
210 POKE V+12*64+C,RX
220 C=C+1
230 IF C>=W THEN GOSUB 700:GOTO 140
240 GOSUB 600:GOTO 140
500 REM WRITE A$ AT START OF SCREEN ROW Y
510 FOR J=1 TO LEN(A$)
520 POKE V+Y*64+J-1,ASC(MID$(A$,J,1))
530 NEXT J
540 RETURN
600 REM MOVE PRINTHEAD MARKER BELOW PAPER
610 FOR J=0 TO 63:POKE V+13*64+J,32:NEXT J
620 POKE V+13*64+C,94
630 RETURN
700 REM PAPER FEED: SHIFT ALL 64 COLUMNS UP
710 FOR R=3 TO 11
720 FOR J=0 TO 63
730 POKE V+R*64+J,PEEK(V+(R+1)*64+J)
740 NEXT J
750 NEXT R
760 FOR J=0 TO 63:POKE V+12*64+J,32:NEXT J
770 C=0:GOSUB 600
780 RETURN
800 REM BACKSPACE ONE POSITION
810 IF C=0 THEN RETURN
820 C=C-1:POKE V+12*64+C,32
830 GOSUB 600
840 RETURN
