10 REM TELETYPE V0.8 - TRSDOS MODEL III BASIC
20 REM FAST LOCAL LOOPBACK OR REAL RS232
30 REM MACHINE CODE PAPER FEED VIA DEFUSR0
35 REM START BASIC WITH MEMORY SIZE 61439
40 CLEAR 200
45 IF PEEK(16561)+256*PEEK(16562)>61439 THEN PRINT "RESTART BASIC: MEMORY SIZE? 61439":END
50 DEFUSR0=-4096
55 FOR I=0 TO 24:READ D:POKE -4096+I,D:NEXT I
60 V=15360:C=0:B=9600:M=1:Q=0
70 CLS
80 A$="TRS-80 MODEL III TELETYPE V0.8"
90 Y=0:GOSUB 500
100 A$="SELECT OPERATING MODE"
110 Y=2:GOSUB 500
120 A$="1 - LOCAL LOOPBACK (FAST, DEFAULT)"
130 Y=4:GOSUB 500
140 A$="2 - REAL RS232 SERIAL PORT"
150 Y=5:GOSUB 500
160 A$="PRESS 1, 2 OR ENTER"
170 Y=7:GOSUB 500
180 A$=INKEY$:IF A$="" THEN 180
190 IF A$="2" THEN M=2:GOTO 230
200 IF A$="1" THEN 330
210 IF ASC(A$)=13 THEN 330
220 GOTO 180
230 CLS
240 A$="REAL RS232 BAUD RATE (8N1)"
250 Y=0:GOSUB 500
260 A$="1 - 9600 BAUD (DEFAULT)    2 - 300 BAUD"
270 Y=2:GOSUB 500
280 A$="PRESS 1, 2 OR ENTER"
290 Y=4:GOSUB 500
300 A$=INKEY$:IF A$="" THEN 300
310 IF A$="2" THEN B=300:GOTO 325
315 IF A$<>"1" AND ASC(A$)<>13 THEN 300
325 GOSUB 900
330 CLS
340 A$="TRS-80 MODEL III TELETYPE"
350 Y=0:GOSUB 500
355 IF M=1 THEN A$="LOCAL LOOPBACK - UNTHROTTLED"
360 IF M=2 THEN A$="REAL RS232 - REMOTE ECHO EXPECTED"
365 Y=1:GOSUB 500
370 IF M=2 AND B=9600 THEN A$="9600 BAUD 8N1"
375 IF M=2 AND B=300 THEN A$="300 BAUD 8N1"
380 IF M=2 THEN Y=2:GOSUB 500
385 A$="ENTER=FEED (LOCAL)  CTRL-]=EXIT"
390 Y=15:GOSUB 500
395 POKE V+832,94
400 IF M=2 THEN GOTO 1000
405 REM FAST LOCAL KEYBOARD LOOP - NO BAUD DELAY
410 A$=INKEY$:IF A$="" THEN 410
415 K=ASC(A$)
420 IF K=29 THEN CLS:END
425 IF K=13 OR K=10 THEN GOSUB 700:GOTO 410
430 IF K=8 THEN GOSUB 800:GOTO 410
435 IF K<32 OR K>126 THEN 410
440 POKE V+768+C,K
445 POKE V+832+C,32
450 C=C+1
455 IF C=64 THEN GOSUB 700:GOTO 410
460 POKE V+832+C,94
465 GOTO 410
500 REM PRINT MENU STRING AT SCREEN ROW Y
510 FOR J=1 TO LEN(A$)
520 POKE V+Y*64+J-1,ASC(MID$(A$,J,1))
530 NEXT J
540 RETURN
700 REM FAST PAPER FEED IN 25 BYTE Z80 SUBROUTINE
710 Z=USR0(0)
720 IF C<64 THEN POKE V+832+C,32
730 C=0:POKE V+832,94
740 RETURN
800 REM BACKSPACE ONE CHARACTER
810 IF C=0 THEN RETURN
815 POKE V+832+C,32
820 C=C-1:POKE V+768+C,32
830 POKE V+832+C,94
840 RETURN
900 REM INITIALISE REAL MODEL III RS232 ONLY
910 OUT 232,0
920 IF B=9600 THEN OUT 233,238
930 IF B=300 THEN OUT 233,85
940 OUT 234,104
950 RETURN
1000 REM REAL RS232 POLLING - 9600 IS EXPERIMENTAL
1010 S=INP(234)
1020 IF (S AND 128)<>0 THEN RX=INP(235):GOSUB 1200
1030 A$=INKEY$:IF A$="" THEN 1000
1040 TX=ASC(A$)
1050 IF TX=29 THEN CLS:END
1060 S=INP(234)
1070 IF (S AND 64)=0 THEN 1060
1080 OUT 235,TX
1090 GOTO 1000
1200 REM PRINT RECEIVED BYTE (REMOTE ECHO)
1210 IF RX=13 THEN Q=1:GOSUB 700:RETURN
1220 IF RX=10 AND Q=1 THEN Q=0:RETURN
1230 Q=0
1240 IF RX=10 THEN GOSUB 700:RETURN
1250 IF RX=8 THEN GOSUB 800:RETURN
1260 IF RX<32 OR RX>126 THEN RETURN
1270 POKE V+768+C,RX
1280 POKE V+832+C,32
1290 C=C+1
1300 IF C=64 THEN GOSUB 700:RETURN
1310 POKE V+832+C,94
1320 RETURN
1400 REM Z80: LDIR PAPER 576 BYTES; CLEAR BOTTOM 64
1410 DATA 33,0,61,17,192,60,1,64,2,237,176
1420 DATA 33,0,63,54,32,17,1,63,1,63,0,237,176,201
