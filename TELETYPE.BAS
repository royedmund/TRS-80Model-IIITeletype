10 REM TELETYPE V0.6 - TRSDOS MODEL III DISK BASIC
20 REM LOCAL LOOPBACK OR REAL RS232 - 9600/300 8N1
30 REM REAL RS232 MODE IS EXPERIMENTAL
40 CLEAR 200
50 V=15360:W=64:C=0:B=9600:M=1:Q=0
60 CLS
70 A$="TRS-80 MODEL III TELETYPE V0.6"
80 Y=0:GOSUB 500
90 A$="BAUD RATE: 1=9600 (DEFAULT)   2=300"
100 Y=2:GOSUB 500
110 A$="PRESS 1, 2 OR ENTER"
120 Y=4:GOSUB 500
130 A$=INKEY$:IF A$="" THEN 130
140 IF A$="2" THEN B=300:GOTO 180
150 IF A$="1" THEN 180
160 IF ASC(A$)<>13 THEN 130
180 CLS
190 A$="TELETYPE - SELECT OPERATING MODE"
200 Y=0:GOSUB 500
210 A$="1 - LOCAL SOFTWARE LOOPBACK (DEFAULT)"
220 Y=2:GOSUB 500
230 A$="2 - REAL RS232 SERIAL PORT"
240 Y=3:GOSUB 500
250 A$="PRESS 1, 2 OR ENTER"
260 Y=5:GOSUB 500
270 A$=INKEY$:IF A$="" THEN 270
280 IF A$="2" THEN M=2:GOTO 320
290 IF A$="1" THEN 320
300 IF ASC(A$)<>13 THEN 270
320 IF M=2 THEN GOSUB 900
330 CLS
340 A$="TRS-80 MODEL III TELETYPE"
350 Y=0:GOSUB 500
360 IF M=1 THEN A$="LOCAL SOFTWARE LOOPBACK"
370 IF M=2 THEN A$="REAL RS232 - REMOTE ECHO EXPECTED"
380 Y=1:GOSUB 500
390 IF B=9600 THEN A$="9600 BAUD 8N1"
400 IF B=300 THEN A$="300 BAUD 8N1"
410 Y=2:GOSUB 500
420 A$="ENTER=FEED (LOCAL)  CTRL-]=EXIT"
430 Y=15:GOSUB 500
440 GOSUB 600
450 IF M=2 THEN GOSUB 1000
460 A$=INKEY$:IF A$="" THEN 450
470 TX=ASC(A$)
480 IF TX=29 THEN CLS:END
490 IF M=2 THEN GOSUB 1100:GOTO 450
495 RX=TX:GOSUB 1200:GOTO 450
500 REM RENDER STRING A$ AT ROW Y
510 FOR J=1 TO LEN(A$)
520 POKE V+Y*64+J-1,ASC(MID$(A$,J,1))
530 NEXT J
540 RETURN
600 REM PRINTHEAD MARKER
610 FOR J=0 TO 63:POKE V+13*64+J,32:NEXT J
620 POKE V+13*64+C,94
630 RETURN
700 REM PAPER FEED UP ONE ROW
710 FOR R=3 TO 11
720 FOR J=0 TO 63
730 POKE V+R*64+J,PEEK(V+(R+1)*64+J)
740 NEXT J
750 NEXT R
760 FOR J=0 TO 63:POKE V+12*64+J,32:NEXT J
770 C=0:GOSUB 600
780 RETURN
800 REM BACKSPACE
810 IF C=0 THEN RETURN
820 C=C-1:POKE V+12*64+C,32
830 GOSUB 600
840 RETURN
900 REM CONFIGURE MODEL III UART FOR 8N1
910 OUT 232,0
920 IF B=9600 THEN OUT 233,238
930 IF B=300 THEN OUT 233,85
940 OUT 234,104
950 RETURN
1000 REM POLL REAL RS232 FOR RECEIVED BYTE
1010 S=INP(234)
1020 IF (S AND 128)=0 THEN RETURN
1030 RX=INP(235)
1040 GOSUB 1200
1050 RETURN
1100 REM SEND KEY TO REAL RS232 (WAIT FOR TX READY)
1110 S=INP(234)
1120 IF (S AND 64)=0 THEN 1110
1130 OUT 235,TX
1140 RETURN
1200 REM PRINT RECEIVED CHARACTER OR HANDLE CONTROL
1210 IF RX=13 THEN Q=1:GOSUB 700:RETURN
1220 IF RX=10 AND Q=1 THEN Q=0:RETURN
1230 Q=0
1240 IF RX=10 THEN GOSUB 700:RETURN
1250 IF RX=8 THEN GOSUB 800:RETURN
1260 IF RX<32 OR RX>126 THEN RETURN
1270 POKE V+12*64+C,RX
1280 C=C+1
1290 IF C>=W THEN GOSUB 700:RETURN
1300 GOSUB 600
1310 RETURN
