10 REM TELETYPE V0.5 - TRS-80 MODEL III DISK BASIC
20 REM SOFTWARE LOOPBACK - NO HARDWARE RS232
30 REM 64 COLUMN PAPER - STARTUP BAUD MENU
40 CLEAR 200
50 V=15360:W=64:C=0:B=9600
60 CLS
70 A$="TRS-80 MODEL III TELETYPE - LOCAL MODE"
80 Y=0:GOSUB 500
90 A$="SELECT BAUD RATE (8 DATA, NO PARITY, 1 STOP)"
100 Y=2:GOSUB 500
110 A$="1 - 9600 BAUD (DEFAULT)"
120 Y=4:GOSUB 500
130 A$="2 - 300 BAUD"
140 Y=5:GOSUB 500
150 A$="PRESS 1, 2 OR ENTER FOR DEFAULT"
160 Y=7:GOSUB 500
170 A$=INKEY$:IF A$="" THEN 170
180 IF A$="2" THEN B=300:GOTO 210
190 IF A$="1" THEN 210
200 IF ASC(A$)<>13 THEN 170
210 CLS
220 A$="TRS-80 MODEL III TELETYPE - LOCAL MODE"
230 Y=0:GOSUB 500
240 IF B=300 THEN A$="SOFTWARE LOOPBACK - 300 BAUD 8N1"
250 IF B=9600 THEN A$="SOFTWARE LOOPBACK - 9600 BAUD 8N1"
260 Y=1:GOSUB 500
270 A$="ENTER=FEED  BACKSPACE=ERASE  CTRL-]=EXIT"
280 Y=15:GOSUB 500
290 GOSUB 600
300 A$=INKEY$:IF A$="" THEN 300
310 TX=ASC(A$)
320 IF TX=29 THEN CLS:END
330 RX=TX:REM SOFTWARE LOOPBACK - BAUD NOT TIMED
340 IF RX=13 OR RX=10 THEN GOSUB 700:GOTO 300
350 IF RX=8 THEN GOSUB 800:GOTO 300
360 IF RX<32 OR RX>126 THEN 300
370 POKE V+12*64+C,RX
380 C=C+1
390 IF C>=W THEN GOSUB 700:GOTO 300
400 GOSUB 600:GOTO 300
500 REM WRITE A$ AT START OF ROW Y
510 FOR J=1 TO LEN(A$)
520 POKE V+Y*64+J-1,ASC(MID$(A$,J,1))
530 NEXT J
540 RETURN
600 REM PRINTHEAD MARKER BELOW PAPER
610 FOR J=0 TO 63:POKE V+13*64+J,32:NEXT J
620 POKE V+13*64+C,94
630 RETURN
700 REM PAPER FEED: SCROLL ALL 64 COLUMNS
710 FOR R=3 TO 11
720 FOR J=0 TO 63
730 POKE V+R*64+J,PEEK(V+(R+1)*64+J)
740 NEXT J
750 NEXT R
760 FOR J=0 TO 63:POKE V+12*64+J,32:NEXT J
770 C=0:GOSUB 600
780 RETURN
800 REM BACKSPACE ONE COLUMN
810 IF C=0 THEN RETURN
820 C=C-1:POKE V+12*64+C,32
830 GOSUB 600
840 RETURN
